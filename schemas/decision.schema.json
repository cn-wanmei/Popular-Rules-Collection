{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/universal-rules/decision.schema.json",
  "title": "Decision",
  "type": "object",
  "required": ["decision_id", "target", "action", "reason", "created_by", "created_at"],
  "properties": {
    "decision_id": {"type": "string"},
    "target": {"type": "object", "required": ["type", "value"], "properties": {"type": {"type": "string"}, "value": {"type": "string"}}, "additionalProperties": false},
    "action": {"type": "string"},
    "reason": {"type": "string", "minLength": 1},
    "created_by": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": false
}