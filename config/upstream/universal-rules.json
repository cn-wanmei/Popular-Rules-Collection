version: 1
upstream:
  repository: cn-wanmei/Universal-Rules-Collection
  ref: main
  manifest_url: https://raw.githubusercontent.com/cn-wanmei/Universal-Rules-Collection/main/releases/stable/manifest.json
  client_input_url: https://raw.githubusercontent.com/cn-wanmei/Universal-Rules-Collection/main/releases/stable/client-input.jsonl
  schema_url: https://raw.githubusercontent.com/cn-wanmei/Universal-Rules-Collection/main/schema/rule.schema.json
input:
  format: jsonl
  preserve_fields:
    - id
    - kind
    - pattern
    - action
    - category
    - popularity_score
    - source
    - sources
    - provenance
policy:
  require_provenance: true
  reject_unknown_action: true
  verify_manifest_checksum: true
  fail_closed: true
